# ========================================
# Discord Bot Configuration
# ========================================

# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/titanbot

# API Configuration
API_PORT=3000
WEB_HOST=0.0.0.0
PUBLIC_DASHBOARD_URL=https://your-dashboard-url.com

# ========================================
# AI Service Configuration (NEW)
# ========================================

# Enable AI features by setting these:
# Supported providers: openai, claude, gemini, google-ai, groq, huggingface, tavily

# AI Provider (Required for AI features)
# AI_PROVIDER=openai|claude|gemini|google-ai|groq|huggingface|tavily
AI_PROVIDER=

# AI API Key (Required for AI features)
# Get your key from the provider's website
AI_API_KEY=

# AI Model to use (Required for AI features)
# Examples:
# - OpenAI: gpt-4, gpt-3.5-turbo
# - Claude: claude-3-opus-20240229, claude-3-sonnet-20240229
# - Gemini: gemini-pro
# - Google AI Studio: gemini-1.5-pro, gemini-1.5-flash
# - Groq: mixtral-8x7b-32768, llama2-70b-4096 (FASTEST!)
# - HuggingFace: mistral/Mistral-7B-Instruct-v0.1, meta-llama/Llama-2-7b-chat
# - Tavily: tavily-search, tavily-qna (web search integration)
AI_MODEL=

# AI Model Parameters (Optional)
# Maximum tokens for AI responses (default: 2000)
AI_MAX_TOKENS=2000

# Temperature for AI responses (0.0 = deterministic, 1.0 = creative)
# Default: 0.7
AI_TEMPERATURE=0.7

# ========================================
# Provider-Specific Setup Guide
# ========================================

# OpenAI (ChatGPT)
# 1. Go to https://platform.openai.com/api-keys
# 2. Create a new secret key
# 3. Set AI_PROVIDER=openai
# 4. Set AI_API_KEY=sk-...
# 5. Set AI_MODEL=gpt-4 (or gpt-3.5-turbo for cheaper option)

# Anthropic (Claude)
# 1. Go to https://console.anthropic.com/
# 2. Create API key in the API section
# 3. Set AI_PROVIDER=claude
# 4. Set AI_API_KEY=sk-ant-...
# 5. Set AI_MODEL=claude-3-opus-20240229

# Google (Gemini) - Legacy
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Create API key for Gemini
# 3. Set AI_PROVIDER=gemini
# 4. Set AI_API_KEY=AIza...
# 5. Set AI_MODEL=gemini-pro

# Google AI Studio - NEW & RECOMMENDED
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Create API key (new improved version)
# 3. Set AI_PROVIDER=google-ai
# 4. Set AI_API_KEY=AIza...
# 5. Set AI_MODEL=gemini-1.5-pro or gemini-1.5-flash

# Groq - FASTEST INFERENCE
# 1. Go to https://console.groq.com/keys
# 2. Create API key
# 3. Set AI_PROVIDER=groq
# 4. Set AI_API_KEY=gsk_...
# 5. Set AI_MODEL=mixtral-8x7b-32768
# ⚡ 100+ tokens/second, free tier available

# HuggingFace - OPEN SOURCE MODELS
# 1. Go to https://huggingface.co/settings/tokens
# 2. Create API token (read access)
# 3. Set AI_PROVIDER=huggingface
# 4. Set AI_API_KEY=hf_...
# 5. Set AI_MODEL=mistral/Mistral-7B-Instruct-v0.1
# 🤗 Access thousands of open-source models, free tier available

# Tavily - WEB SEARCH + AI
# 1. Go to https://app.tavily.com/home
# 2. Create API key
# 3. Set AI_PROVIDER=tavily
# 4. Set AI_API_KEY=tvly-...
# 5. Set AI_MODEL=tavily-search
# 🔍 Adds real-time web search to AI responses, free tier: 1000/month

# ========================================
# Other Configuration
# ========================================

# Logging
LOG_LEVEL=info
NODE_ENV=production

# Optional: Maintenance Mode
MAINTENANCE_MODE=false

# Optional: Bot Owner ID (for owner-only commands)
BOT_OWNER_ID=your_discord_id
