# ========================================
# Discord Bot Configuration
# ========================================

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here
OWNER_IDS=your_discord_id_here

# ========================================
# Core Runtime
# ========================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
WEB_HOST=0.0.0.0
CORS_ORIGIN=*
MAINTENANCE_MODE=false

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/sky
POSTGRES_URL=postgresql://postgres:yourpassword@localhost:5432/titanbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=titanbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword

# ========================================
# AI Service Configuration
# ========================================
# Supported providers: google-ai, groq, huggingface, tavily
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Google AI Studio
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Create an API key
# 3. Set AI_PROVIDER=google-ai
# 4. Set AI_API_KEY=AIza...
# 5. Set AI_MODEL=gemini-1.5-pro or gemini-1.5-flash

# Groq
# 1. Go to https://console.groq.com/keys
# 2. Create an API key
# 3. Set AI_PROVIDER=groq
# 4. Set AI_API_KEY=gsk_...
# 5. Set AI_MODEL=mixtral-8x7b-32768

# HuggingFace
# 1. Go to https://huggingface.co/settings/tokens
# 2. Create a token
# 3. Set AI_PROVIDER=huggingface
# 4. Set AI_API_KEY=hf_...
# 5. Set AI_MODEL=mistral/Mistral-7B-Instruct-v0.1

# Tavily
# 1. Go to https://app.tavily.com/home
# 2. Create an API key
# 3. Set AI_PROVIDER=tavily
# 4. Set AI_API_KEY=tvly-...
# 5. Set AI_MODEL=tavily-search

# ========================================
# Security / Anti-Abuse
# ========================================
ANTI_NUKE=true
ANTI_MOD=true
SECURITY_ALERT_CHANNEL_ID=
SECURITY_MANAGER_ROLES=
TRUSTED_USER_IDS=

# ========================================
# Other Configuration
# ========================================
LOG_TO_FILE=false
SENTRY_DSN=
TMDB_API_KEY=
BOT_OWNER_ID=your_discord_id
